# ============================================================
# 预算魔法账本 · AI 中转代理 环境变量模板
# 使用方式：复制本文件为 .env 并填写真实值
#   Windows (PowerShell): Copy-Item .env.example .env
#   macOS / Linux:        cp .env.example .env
#
# ⚠️ 安全提醒：.env 包含 DeepSeek API 密钥，严禁上传至代码仓库！
#   本文件（.env.example）可提交，但真实密钥只允许出现在本地 .env 中。
# ============================================================

# DeepSeek API 密钥（必填）
# 获取地址：https://platform.deepseek.com/  -> API Keys
DEEPSEEK_API_KEY=

# DeepSeek OpenAI 兼容接口地址（无需改动）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions

# 默认模型（前端未指定 model 时的兜底）
MODEL_NAME=deepseek-chat

# 服务监听端口
PORT=8787

# 上游请求超时时间（毫秒）
TIMEOUT_MS=30000
